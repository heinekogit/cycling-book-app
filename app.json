{
  "expo": {
    "name": "Cycling Book",
    "slug": "cycling-book-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./logo.png",
    "scheme": "cyclingbook",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F4F7F3",
    "ios": {
      "icon": "./logo.png",
      "bundleIdentifier": "com.dotblotworks.cyclingbook",
      "supportsTablet": true,
      "appleTeamId": "Z638ZXC26R"
    },
    "android": {
      "package": "jp.cyclingbook.app",
      "icon": "./logo.png",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F7F3",
          "image": "./logo.png",
          "imageWidth": 160
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "走行中の現在地と軌跡を記録するため、位置情報を使用します。",
          "locationAlwaysAndWhenInUsePermission": "画面を閉じている間も走行軌跡を記録するため、位置情報を使用します。",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "expo-sqlite",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "cameraPermission": "実走中の写真を撮影し、走行地点とともに保存するためカメラを使用します。",
          "photosPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
