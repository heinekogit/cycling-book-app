{
  "expo": {
    "name": "Cycling Book",
    "slug": "cycling-book-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "cyclingbook",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F4F7F3",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "jp.cyclingbook.app",
      "supportsTablet": true
    },
    "android": {
      "package": "jp.cyclingbook.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "走行中の現在地と軌跡を記録するため、位置情報を使用します。",
          "locationAlwaysAndWhenInUsePermission": "画面を閉じている間も走行軌跡を記録するため、位置情報を使用します。",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
